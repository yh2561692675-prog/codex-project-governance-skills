{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex.local/schemas/project-governance-profile-v1.1.schema.json",
  "title": "Project Governance Profile V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "projectType",
    "gitRoot",
    "gitRootVerified",
    "defaultPriority",
    "defaultReview",
    "allowedWritePaths",
    "protectedPaths",
    "containsBusinessContent",
    "containsPersonalData",
    "containsSecrets",
    "activeRunMigration",
    "deliveryTarget",
    "releaseIntent",
    "reviewPolicy",
    "effectiveFromFreshRun"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "projectType": { "type": "string", "enum": ["high_impact_data", "content_media", "infrastructure_tooling"] },
    "gitRoot": { "type": "string", "pattern": "^[Xx]:[\\\\/].+" },
    "gitRootVerified": { "const": true },
    "defaultPriority": { "const": "lightweight_first" },
    "defaultReview": { "const": "disabled" },
    "allowedWritePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "protectedPaths": { "type": "array", "minItems": 1, "contains": { "const": ".git" }, "items": { "type": "string", "minLength": 1 } },
    "containsBusinessContent": { "const": false },
    "containsPersonalData": { "const": false },
    "containsSecrets": { "const": false },
    "activeRunMigration": { "const": "next_fresh_run" },
    "deliveryTarget": { "type": "string", "enum": ["ENGINEERING_ONLY", "LOCAL_USABLE", "INTERNAL_REVIEW", "FORMAL_RELEASE"] },
    "releaseIntent": { "type": "string", "enum": ["NONE", "INTENDED"] },
    "reviewPolicy": { "type": "string", "enum": ["NONE", "OPTIONAL", "REQUIRED"] },
    "effectiveFromFreshRun": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "deliveryTarget": { "const": "ENGINEERING_ONLY" } } },
      "then": { "properties": { "releaseIntent": { "const": "NONE" }, "reviewPolicy": { "const": "NONE" } } }
    },
    {
      "if": { "properties": { "deliveryTarget": { "const": "LOCAL_USABLE" } } },
      "then": { "properties": { "releaseIntent": { "const": "NONE" }, "reviewPolicy": { "enum": ["NONE", "OPTIONAL"] } } }
    },
    {
      "if": { "properties": { "deliveryTarget": { "const": "INTERNAL_REVIEW" } } },
      "then": { "properties": { "releaseIntent": { "const": "NONE" }, "reviewPolicy": { "const": "REQUIRED" } } }
    },
    {
      "if": { "properties": { "deliveryTarget": { "const": "FORMAL_RELEASE" } } },
      "then": { "properties": { "releaseIntent": { "const": "INTENDED" }, "reviewPolicy": { "const": "REQUIRED" } } }
    }
  ]
}
