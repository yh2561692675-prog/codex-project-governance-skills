{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex.local/schemas/project-governance-catalog-v1.schema.json",
  "title": "Project Governance Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "defaultPriority",
    "defaultReview",
    "unknownRisk",
    "freshRunMigration",
    "uniqueProjectId",
    "projects"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "catalogId": { "const": "lightweight-governance-catalog-v1" },
    "defaultPriority": { "const": "lightweight_first" },
    "defaultReview": { "const": "disabled" },
    "unknownRisk": { "const": "escalate" },
    "freshRunMigration": { "const": "next_fresh_run" },
    "uniqueProjectId": { "const": true },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectType",
          "profilePath",
          "gitRoot",
          "gitRootVerified",
          "profileSchemaVersion",
          "defaultPriority",
          "defaultReview",
          "activeRunMigration"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "projectType": {
            "type": "string",
            "enum": ["high_impact_data", "content_media", "infrastructure_tooling"]
          },
          "profilePath": { "type": "string", "minLength": 1 },
          "gitRoot": {
            "type": "string",
            "pattern": "^[Xx]:[\\\\/].+"
          },
          "gitRootVerified": { "const": true },
          "profileSchemaVersion": { "const": "1.0" },
          "defaultPriority": { "const": "lightweight_first" },
          "defaultReview": { "const": "disabled" },
          "activeRunMigration": { "const": "next_fresh_run" }
        }
      }
    }
  }
}
