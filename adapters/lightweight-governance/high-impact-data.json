{
  "schema_version": 1,
  "adapter_type": "high-impact-data",
  "summary": "Default lightweight governance for data, fact, and recommendation work.",
  "default_final_review": {
    "required": true,
    "decision_values": ["通过", "需修改", "不通过"],
    "human_fields": ["decision", "reviewer", "notes"]
  },
  "triggers": {
    "data": ["formal_data", "accepted_fact", "personal_or_student_data"],
    "media": ["source_attachment", "evidence_media"],
    "permissions": ["paid_or_external_account", "production_or_publication"]
  },
  "tests": {
    "commands": [
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills\\lightweight-project-governance\\scripts\\Convert-LegacyGovernanceProfile.Tests.ps1"
    ],
    "required_cases": [
      "ordinary_path_is_lightweight",
      "hard_triggers_fail_closed",
      "unknown_fields_require_manual_mapping",
      "legacy_history_is_preserved"
    ]
  },
  "rollback": {
    "strategy": "Discard the candidate profile and continue using the source legacy governance profile.",
    "steps": [
      "Keep the source profile unchanged.",
      "Remove only the unaccepted migration suggestion.",
      "Re-enter the legacy governance path with historical evidence references intact."
    ]
  }
}
