{
  "schema_version": 1,
  "adapter_type": "content-media",
  "summary": "Default lightweight governance for content, media, and distribution work.",
  "default_final_review": {
    "required": true,
    "decision_values": ["通过", "需修改", "不通过"],
    "human_fields": ["decision", "reviewer", "notes"]
  },
  "triggers": {
    "data": ["formal_data", "personal_or_student_data"],
    "media": ["media_ingest", "copyrighted_content", "public_distribution"],
    "permissions": ["account_permission", "external_distribution", "production_or_publication"]
  },
  "tests": {
    "commands": [
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills\\lightweight-project-governance\\scripts\\Convert-LegacyGovernanceProfile.Tests.ps1"
    ],
    "required_cases": [
      "ordinary_path_is_lightweight",
      "media_trigger_requires_review",
      "permission_trigger_fails_closed",
      "legacy_history_is_preserved"
    ]
  },
  "rollback": {
    "strategy": "Discard the candidate profile and keep the source content governance unchanged.",
    "steps": [
      "Do not rewrite source media or content records.",
      "Remove only the unaccepted migration suggestion.",
      "Resume the legacy review and distribution controls."
    ]
  }
}
